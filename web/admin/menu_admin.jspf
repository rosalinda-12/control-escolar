<%@page import="modelo.Usuario"%>
<%@page import="jakarta.servlet.RequestDispatcher"%>
<%@page import="servicio.ServicioAutorizacion"%>
<%@page import="servicio.ServicioAprobacionRegistro"%>
<%
    Usuario usuarioSesion = (Usuario) session.getAttribute("usuario");
    Object uriOriginal = request.getAttribute(RequestDispatcher.FORWARD_REQUEST_URI);
    String uriActual = uriOriginal != null ? uriOriginal.toString() : request.getRequestURI();

    // Los enlaces se ocultan según permiso, pero eso es solo comodidad
    // visual: cada Servlet vuelve a validar el permiso por su cuenta y
    // responde 403 si alguien entra directo por la URL sin tenerlo.
    ServicioAutorizacion autorizacion = new ServicioAutorizacion();
    boolean puedeCarreras = autorizacion.tienePermiso(usuarioSesion, "carreras.ver");
    boolean puedeMaterias = autorizacion.tienePermiso(usuarioSesion, "materias.ver");
    boolean puedeGrupos = autorizacion.tienePermiso(usuarioSesion, "grupos.ver");
    boolean puedeDocentes = autorizacion.tienePermiso(usuarioSesion, "docentes.ver");
    boolean puedeUsuarios = autorizacion.tienePermiso(usuarioSesion, "usuarios.ver");
    boolean puedeRoles = autorizacion.tienePermiso(usuarioSesion, "roles.gestionar");
    boolean puedePermisos = autorizacion.tienePermiso(usuarioSesion, "permisos.gestionar");
    boolean puedeSolicitudes = autorizacion.tienePermiso(usuarioSesion, "usuarios.aprobar_registro");
    boolean puedeSubdirectores = autorizacion.tienePermiso(usuarioSesion, "subdirectores.ver");
    boolean puedeCalificaciones = autorizacion.tienePermiso(usuarioSesion, "calificaciones.ver");

    int totalSolicitudesPendientes = puedeSolicitudes ? new ServicioAprobacionRegistro().listarPendientes().size() : 0;

    String iniciales = "" + (usuarioSesion.getNombres() != null && !usuarioSesion.getNombres().isEmpty() ? usuarioSesion.getNombres().charAt(0) : '?')
            + (usuarioSesion.getApellidoPaterno() != null && !usuarioSesion.getApellidoPaterno().isEmpty() ? usuarioSesion.getApellidoPaterno().charAt(0) : "");
%>
<script>(function(){try{var t=localStorage.getItem("ce-tema");if(!t){t=(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches)?"dark":"light";}document.documentElement.setAttribute("data-theme",t);}catch(e){}})();</script>
<div class="app-shell">
    <aside class="sidebar">
        <a class="sidebar-brand" href="SPanel">
            
            <span class="sidebar-brand-text">
                <span>CONTROL ESCOLAR</span>
                
            </span>
        </a>

        <nav class="sidebar-nav">
            <a class="sidebar-link <%= uriActual.contains("SPanel") ? "active" : ""%>" href="SPanel">
                <i class="bi bi-house-door"></i>Inicio
            </a>

            <% if (puedeSolicitudes) { %>
            <a class="sidebar-link <%= uriActual.contains("SSolicitudesRegistro") ? "active" : ""%>" href="SSolicitudesRegistro">
                <i class="bi bi-file-earmark-check"></i>Solicitudes
                <% if (totalSolicitudesPendientes > 0) { %>
                <span class="badge-conteo"><%= totalSolicitudesPendientes%></span>
                <% } %>
            </a>
            <% } %>

            <% if (puedeCarreras || puedeMaterias) { %>
            <details class="sidebar-group" <%= (uriActual.contains("SCarreras") || uriActual.contains("SPlanes") || uriActual.contains("SNiveles") || uriActual.contains("SCurriculo") || uriActual.contains("SMaterias")) ? "open" : ""%>>
                <summary class="sidebar-link"><i class="bi bi-mortarboard"></i>Académico</summary>
                <div class="sidebar-subnav">
                    <% if (puedeCarreras) { %>
                    <a class="sidebar-link <%= uriActual.contains("SCarreras") ? "active" : ""%>" href="SCarreras">Carreras</a>
                    <% } %>
                    <a class="sidebar-link <%= uriActual.contains("SPlanes") ? "active" : ""%>" href="SPlanes">Planes de estudio</a>
                    <a class="sidebar-link <%= uriActual.contains("SNiveles") ? "active" : ""%>" href="SNiveles">Niveles académicos</a>
                    <a class="sidebar-link <%= uriActual.contains("SCurriculo") ? "active" : ""%>" href="SCurriculo">Currículo</a>
                    <% if (puedeMaterias) { %>
                    <a class="sidebar-link <%= uriActual.contains("SMaterias") ? "active" : ""%>" href="SMaterias">Materias</a>
                    <% } %>
                </div>
            </details>
            <% } %>

            <details class="sidebar-group" <%= (uriActual.contains("SAlumnos") || uriActual.contains("SInscripciones") || uriActual.contains("SGrupos") || uriActual.contains("SPeriodos") || uriActual.contains("SCiclos") || uriActual.contains("SGeneraciones")) ? "open" : ""%>>
                <summary class="sidebar-link"><i class="bi bi-journal-bookmark"></i>Control escolar</summary>
                <div class="sidebar-subnav">
                    <a class="sidebar-link <%= uriActual.contains("SAlumnos") ? "active" : ""%>" href="SAlumnos">Alumnos</a>
                    <a class="sidebar-link <%= uriActual.contains("SInscripciones") ? "active" : ""%>" href="SInscripciones">Inscripciones / Reinscripciones</a>
                    <% if (puedeGrupos) { %>
                    <a class="sidebar-link <%= uriActual.contains("SGrupos") ? "active" : ""%>" href="SGrupos">Grupos</a>
                    <% } %>
                    <a class="sidebar-link <%= uriActual.contains("SPeriodos") ? "active" : ""%>" href="SPeriodos">Periodos</a>
                    <a class="sidebar-link <%= uriActual.contains("SCiclos") ? "active" : ""%>" href="SCiclos">Ciclos escolares</a>
                    <a class="sidebar-link <%= uriActual.contains("SGeneraciones") ? "active" : ""%>" href="SGeneraciones">Generaciones</a>
                    <% if (puedeCalificaciones) { %>
                    <a class="sidebar-link <%= uriActual.contains("SCalificaciones") ? "active" : ""%>" href="SCalificaciones">Calificaciones</a>
                    <% } %>
                </div>
            </details>

            <% if (puedeDocentes || puedeSubdirectores) { %>
            <details class="sidebar-group" <%= (uriActual.contains("SDocentes") || uriActual.contains("SAsignaciones") || uriActual.contains("SSubdirectores")) ? "open" : ""%>>
                <summary class="sidebar-link"><i class="bi bi-person-workspace"></i>Docencia</summary>
                <div class="sidebar-subnav">
                    <% if (puedeDocentes) { %>
                    <a class="sidebar-link <%= uriActual.contains("SDocentes") ? "active" : ""%>" href="SDocentes">Docentes</a>
                    <a class="sidebar-link <%= uriActual.contains("SAsignaciones") ? "active" : ""%>" href="SGrupos">Asignaciones (desde Grupos)</a>
                    <% } %>
                    <% if (puedeSubdirectores) { %>
                    <a class="sidebar-link <%= uriActual.contains("SSubdirectores") ? "active" : ""%>" href="SSubdirectores">Subdirectores</a>
                    <% } %>
                </div>
            </details>
            <% } %>

            <a class="sidebar-link <%= uriActual.contains("SConfiguracionParcial") ? "active" : ""%>" href="SConfiguracionParcial">
                <i class="bi bi-toggles"></i>Parcial activo
            </a>

            <% if (puedeUsuarios || puedeRoles || puedePermisos) { %>
            <details class="sidebar-group" <%= (uriActual.contains("SUsuarios") || uriActual.contains("SRoles") || uriActual.contains("SPermisos")) ? "open" : ""%>>
                <summary class="sidebar-link"><i class="bi bi-shield-lock"></i>Seguridad</summary>
                <div class="sidebar-subnav">
                    <% if (puedeUsuarios) { %>
                    <a class="sidebar-link <%= uriActual.contains("SUsuarios") ? "active" : ""%>" href="SUsuarios">Usuarios</a>
                    <% } %>
                    <% if (puedeRoles) { %>
                    <a class="sidebar-link <%= uriActual.contains("SRoles") ? "active" : ""%>" href="SRoles">Roles</a>
                    <% } %>
                    <% if (puedePermisos) { %>
                    <a class="sidebar-link <%= uriActual.contains("SPermisos") ? "active" : ""%>" href="SPermisos">Permisos</a>
                    <% } %>
                </div>
            </details>
            <% } %>

            <a class="sidebar-link <%= uriActual.contains("SBitacora") ? "active" : ""%>" href="SBitacora">
                <i class="bi bi-clock-history"></i>Historial
            </a>
        </nav>

        <div class="sidebar-footer">
            <a class="sidebar-link" href="../SLogout"><i class="bi bi-box-arrow-right"></i>Cerrar sesión</a>
        </div>
    </aside>

    <div class="main-wrap">
        <header class="topbar">
            <button class="topbar-toggle" type="button" data-toggle-sidebar aria-label="Abrir menú">
                <i class="bi bi-list"></i>
            </button>
            <div class="topbar-search">
                <i class="bi bi-search"></i>
                <input type="text" data-buscador placeholder="Buscar en el sistema...">
                <kbd>Ctrl+K</kbd>
            </div>
            <div class="topbar-actions">
                <% if (puedeSolicitudes) { %>
                <a class="icon-btn" href="SSolicitudesRegistro" data-tooltip="Solicitudes pendientes">
                    <i class="bi bi-bell"></i>
                    <% if (totalSolicitudesPendientes > 0) { %>
                    <span class="badge-conteo"><%= totalSolicitudesPendientes%></span>
                    <% } %>
                </a>
                <% } %>
                <button type="button" class="icon-btn theme-toggle" data-theme-toggle data-tooltip="Cambiar tema" aria-pressed="false">
                    <i class="bi bi-moon-stars-fill"></i>
                    <i class="bi bi-sun-fill"></i>
                </button>
                <div class="dropdown">
                    <button class="topbar-user btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="topbar-user-avatar"><%= iniciales.toUpperCase()%></div>
                        <div class="topbar-user-info">
                            <span class="topbar-user-name"><%= usuarioSesion.getNombres()%></span>
                            <span class="topbar-user-role"><%= usuarioSesion.getNombreRol()%></span>
                        </div>
                        <i class="bi bi-chevron-down topbar-user-caret"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="px-3 py-1 texto-info">Sesión iniciada como<br><strong><%= usuarioSesion.getCorreo()%></strong></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="../SLogout"><i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión</a></li>
                    </ul>
                </div>
            </div>
        </header>
        <main class="contenido">
