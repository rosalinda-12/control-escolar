<%@page import="modelo.Usuario"%>
<%@page import="jakarta.servlet.RequestDispatcher"%>
<%
    Usuario usuarioSesion = (Usuario) session.getAttribute("usuario");
    Object uriOriginal = request.getAttribute(RequestDispatcher.FORWARD_REQUEST_URI);
    String uriActual = uriOriginal != null ? uriOriginal.toString() : request.getRequestURI();
%>
<nav class="navbar navbar-expand-lg navbar-formal">
    <div class="container-fluid">
        <a class="navbar-brand" href="SPanel"><i class="bi bi-mortarboard me-2"></i>Control Escolar</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuAdmin">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuAdmin">
            <div class="navbar-nav flex-wrap">
                <a class="nav-link <%= uriActual.contains("SPanel") ? "active" : ""%>" href="SPanel">Panel</a>

                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Académico</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item <%= uriActual.contains("SCarreras") ? "active" : ""%>" href="SCarreras">Carreras</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SPlanes") ? "active" : ""%>" href="SPlanes">Planes de estudio</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SNiveles") ? "active" : ""%>" href="SNiveles">Niveles académicos</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SCurriculo") ? "active" : ""%>" href="SCurriculo">Currículo</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SMaterias") ? "active" : ""%>" href="SMaterias">Materias</a></li>
                    </ul>
                </div>

                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Control escolar</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item <%= uriActual.contains("SAlumnos") ? "active" : ""%>" href="SAlumnos">Alumnos</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SInscripciones") ? "active" : ""%>" href="SInscripciones">Inscripciones / Reinscripciones</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SGrupos") ? "active" : ""%>" href="SGrupos">Grupos</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SPeriodos") ? "active" : ""%>" href="SPeriodos">Periodos</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SCiclos") ? "active" : ""%>" href="SCiclos">Ciclos escolares</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SGeneraciones") ? "active" : ""%>" href="SGeneraciones">Generaciones</a></li>
                    </ul>
                </div>

                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Docencia</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item <%= uriActual.contains("SDocentes") ? "active" : ""%>" href="SDocentes">Docentes</a></li>
                        <li><a class="dropdown-item <%= uriActual.contains("SAsignaciones") ? "active" : ""%>" href="SGrupos">Asignaciones (desde Grupos)</a></li>
                    </ul>
                </div>

                <a class="nav-link <%= uriActual.contains("SConfiguracionParcial") ? "active" : ""%>" href="SConfiguracionParcial">Parcial activo</a>
                <a class="nav-link <%= uriActual.contains("SSolicitudesRegistro") ? "active" : ""%>" href="SSolicitudesRegistro">Solicitudes</a>
                <a class="nav-link <%= uriActual.contains("SBitacora") ? "active" : ""%>" href="SBitacora">Historial</a>
                <a class="nav-link" href="../SLogout"><i class="bi bi-box-arrow-right me-1"></i>Salir</a>
            </div>
        </div>
        <span class="texto-info text-white ms-3 d-none d-lg-inline"><%= usuarioSesion.getNombres()%></span>
    </div>
</nav>
