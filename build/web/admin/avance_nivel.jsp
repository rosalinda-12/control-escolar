<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@page import="modelo.TrayectoriaAcademica"%><%@page import="java.util.ArrayList"%>
<% ArrayList<TrayectoriaAcademica> trayectorias=(ArrayList<TrayectoriaAcademica>)request.getAttribute("trayectorias"); String error=(String)session.getAttribute("errorAvance"); String aviso=(String)session.getAttribute("avisoAvance"); session.removeAttribute("errorAvance"); session.removeAttribute("avisoAvance"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Avance de nivel</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link rel="stylesheet" href="../estilo/styles.css"></head><body><%@ include file="menu_admin.jspf" %><main class="container automatizaciones-page"><header class="automatizaciones-hero"><div><span class="trayectoria-eyebrow"><i class="bi bi-arrow-up-circle"></i> Progresión académica</span><h1>Alumnos listos para avanzar</h1><p>El sistema muestra trayectorias activas sin materias pendientes y con un siguiente nivel disponible.</p></div><div class="automatizaciones-hero-icon"><i class="bi bi-mortarboard"></i></div></header><%if(error!=null){%><div class="mensaje-error"><i class="bi bi-exclamation-triangle me-2"></i><%=error%></div><%}%><%if(aviso!=null){%><div class="mensaje-exito"><i class="bi bi-check-circle me-2"></i><%=aviso%></div><%}%><section class="automation-panel"><div class="massive-students-heading"><div><span class="trayectoria-eyebrow">Avance en lote</span><h2>Trayectorias elegibles</h2></div><span class="groups-count"><%=trayectorias.size()%> disponibles</span></div><%if(trayectorias.isEmpty()){%><div class="automation-empty"><i class="bi bi-check2-all"></i><strong>No hay alumnos pendientes de avance</strong><span>Cuando terminen todas las materias del nivel actual aparecerán aquí.</span></div><%}else{%><form method="post" action="SAvanceNivel"><div class="massive-students-grid"><%for(TrayectoriaAcademica t:trayectorias){%><label class="massive-student"><input type="checkbox" name="idsTrayectoria" value="<%=t.getIdTrayectoria()%>"><span><strong><%=t.getNombreAlumno()%></strong><small><%=t.getMatricula()%> · <%=t.getNombreCarrera()%> · <%=t.getNombrePlan()%></small></span></label><%}%></div><button type="submit" class="btn btn-primary-formal automation-submit" onclick="return confirm('¿Crear las trayectorias del siguiente nivel para los alumnos seleccionados?');"><i class="bi bi-arrow-up-circle me-2"></i>Crear siguiente nivel</button></form><%}%></section></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script><script src="../estilo/app.js"></script></body></html>
