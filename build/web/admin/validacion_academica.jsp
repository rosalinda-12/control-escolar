<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@page import="modelo.Periodo"%><%@page import="modelo.ResumenCierrePeriodo"%><%@page import="java.util.ArrayList"%>
<% ArrayList<Periodo> periodos = (ArrayList<Periodo>) request.getAttribute("periodos"); ResumenCierrePeriodo resumen = (ResumenCierrePeriodo) request.getAttribute("resumen"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Validación académica</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet"><link rel="stylesheet" href="../estilo/styles.css"></head><body><%@ include file="menu_admin.jspf" %>
<main class="container automatizaciones-page"><header class="automatizaciones-hero"><div><span class="trayectoria-eyebrow"><i class="bi bi-clipboard2-pulse"></i> Control de calidad</span><h1>Validación académica</h1><p>Revisa pendientes antes de cerrar un periodo o iniciar la reinscripción.</p></div><div class="automatizaciones-hero-icon"><i class="bi bi-shield-check"></i></div></header>
<section class="automation-panel validation-page-panel"><div class="automation-panel-heading"><div><span class="trayectoria-eyebrow">Revisión por periodo</span><h2>Detectar pendientes</h2><p>Elige un periodo para consultar materias sin calificación final, grupos activos e inscripciones.</p></div></div><form method="get" action="SValidacionAcademica" class="automation-selector"><label for="idPeriodoValidacion">Periodo</label><div class="automation-selector-row"><select id="idPeriodoValidacion" name="idPeriodo" class="form-select" required><option value="">Selecciona un periodo</option><% for (Periodo periodo : periodos) { %><option value="<%= periodo.getIdPeriodo()%>" <%= resumen != null && resumen.getIdPeriodo() == periodo.getIdPeriodo() ? "selected" : ""%>><%= periodo.getNombrePeriodo()%> · <%= periodo.getEstatus()%></option><% } %></select><button class="btn btn-primary-formal" type="submit"><i class="bi bi-search me-1"></i>Validar</button></div></form><% if (resumen != null) { %><div class="automation-metrics validation-metrics"><div><strong><%= resumen.getMateriasPendientes()%></strong><span>Materias sin final</span></div><div><strong><%= resumen.getGruposActivos()%></strong><span>Grupos activos</span></div><div><strong><%= resumen.getInscripcionesActivas()%></strong><span>Inscripciones activas</span></div></div><div class="automation-checklist"><div class="<%= resumen.isListoParaCerrar() ? "check-ok" : "check-warning"%>"><i class="bi <%= resumen.isListoParaCerrar() ? "bi-check-circle-fill" : "bi-exclamation-circle-fill"%>"></i><span><strong><%= resumen.isListoParaCerrar() ? "Sin pendientes de calificación" : "Hay materias por completar"%></strong><small>Para revisar o corregir calificaciones, abre el módulo de Calificaciones.</small></span></div></div><a class="btn btn-outline-formal" href="SCalificaciones"><i class="bi bi-table me-1"></i>Ver calificaciones</a><% } else { %><div class="automation-empty"><i class="bi bi-clipboard2-check"></i><strong>Selecciona un periodo</strong><span>La validación mostrará si está listo para el cierre automático.</span></div><% } %></section></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script><script src="../estilo/app.js"></script></body></html>
